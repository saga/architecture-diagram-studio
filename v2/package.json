{
  "name": "architecture-diagram-studio-v2",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "drawio:fetch": "node scripts/bundle-drawio.mjs",
    "predev": "node scripts/bundle-drawio.mjs",
    "dev": "concurrently -k -p none \"npm:dev:web\" \"npm:dev:copilot\" \"npm:dev:drawio\"",
    "prebuild": "node scripts/bundle-drawio.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "concurrently -k -p none \"npm:preview:web\" \"npm:dev:drawio\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "dev:web": "vite --host 0.0.0.0",
    "dev:copilot": "tsx server/copilot-server.ts",
    "start:copilot": "tsx server/copilot-server.ts",
    "preview:web": "vite preview --host 0.0.0.0",
    "dev:drawio": "tsx server/drawio-static-server.ts"
  },
  "dependencies": {
    "@ant-design/x": "^2.9.0",
    "@github/copilot-sdk": "^1.0.26",
    "@xmldom/xmldom": "^0.9.12",
    "antd": "^6.6.5",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7",
    "@dagrejs/dagre":"^3.1.2",
    "elkjs": "^0.12.0",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
