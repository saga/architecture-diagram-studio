# Custom model provider (BYOK) for the Studio Copilot runtime.
#
# The runtime only enters custom-provider mode when COPILOT_PROVIDER_BASE_URL is set. Without it,
# any model id the GitHub catalog does not know is silently routed to a GitHub-hosted model and
# billed against that account's Copilot quota.
#
# Copy this file to .env (git-ignored) and restart `npm run dev`.

# Example: DeepSeek's OpenAI-compatible endpoint.
COPILOT_PROVIDER_BASE_URL=https://api.deepseek.com/v1
COPILOT_PROVIDER_API_KEY=sk-replace-me
COPILOT_PROVIDER_TYPE=openai

# Model id used for the session and sent to the provider. It does not need to be in the
# GitHub catalog; token limits fall back to COPILOT_PROVIDER_MAX_PROMPT_TOKENS /
# COPILOT_PROVIDER_MAX_OUTPUT_TOKENS when the id is unknown.
COPILOT_MODEL=deepseek-flash

# Optional: the wire model when the provider expects a different name than the model id.
# COPILOT_PROVIDER_MODEL_ID=deepseek-flash
# COPILOT_PROVIDER_WIRE_MODEL=deepseek-flash

# Copilot model turn deadline shared by the initial call and its fallback tool-call retry.
# Default: five minutes. Configurable from 10000 ms (10 seconds) to 900000 ms (15 minutes).
STUDIO_COPILOT_TURN_TIMEOUT_MS=300000

# Maximum time without meaningful stream/tool progress before aborting the active model call.
# Default: 90 seconds. Configurable from 10000 ms (10 seconds) to 300000 ms (5 minutes).
# The total turn deadline above remains the hard upper limit, even while progress continues.
STUDIO_COPILOT_TURN_IDLE_TIMEOUT_MS=90000
