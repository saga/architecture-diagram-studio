# GitHub Copilot SDK model. Must be available to your Copilot account.
COPILOT_MODEL=gpt-5

# Local-only API server
PORT=3001

# Optional: use a GitHub token instead of the existing Copilot CLI login.
# Never commit a real token.
# GITHUB_TOKEN=

# Optional: Copilot CLI binary path when you need to override the SDK-bundled runtime.
# COPILOT_CLI_PATH=

# Optional: Copilot home/base directory (defaults to ~/.copilot).
# COPILOT_HOME=
